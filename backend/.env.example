# ==============================================================================
# Infinity Space Group - Backend Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# For local development: copy to .env
# For production: configure these environment variables in your hosting dashboard
# (e.g. Render, Railway, AWS ECS, DigitalOcean App Platform, Fly.io)
# ==============================================================================

# Flask Environment Mode: 'development' | 'production' | 'testing'
FLASK_ENV=production

# Server Port
PORT=5000

# Secret Key (MANDATORY in production - must be a 64+ character random hex string)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-and-set-strong-random-secret-key-here

# Managed PostgreSQL Database Connection String
# Format: postgresql+psycopg2://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?sslmode=require
DATABASE_URL=postgresql+psycopg2://db_user:db_password@db_host:5432/infinity_space_group?sslmode=require

# Frontend Origin for CORS (Exact URL of your deployed Netlify/custom domain, no trailing slash)
# Multiple origins can be comma-separated: https://infinityspacegroup.in,https://admin.infinityspacegroup.in
FRONTEND_ORIGIN=https://infinityspacegroup.in

# Session Cookie Security (True when running behind HTTPS in production)
SESSION_COOKIE_SECURE=true
